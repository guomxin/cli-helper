[Unit]
Description=AgentBridge isolated virtual display
After=network-online.target

[Service]
Type=simple
User=agentbridge
Group=agentbridge
Environment=HOME=/home/guomao/agentbridge/data
ExecStartPre=/bin/sh -c 'umask 077; cookie=$(/usr/bin/mcookie); /usr/bin/xauth -f /home/guomao/agentbridge/data/.Xauthority add :99 . "$cookie"'
ExecStart=/usr/bin/Xvfb :99 -screen 0 1280x1024x24 -nolisten tcp -noreset -auth /home/guomao/agentbridge/data/.Xauthority
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/guomao/agentbridge/data

[Install]
WantedBy=multi-user.target
