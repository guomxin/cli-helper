{
  "schemaVersion": "agentbridge.skills.v1",
  "id": "similar-cases",
  "version": "1.0.4",
  "name": "相似案例检索",
  "description": "从日志中检索类似问题，核对相关性并归并同一事件及后续记录，输出处理措施、明确结果、适用条件、差异和出处。",
  "executionMode": "read_exploration",
  "status": "trial",
  "entrypoint": "SKILL.md",
  "resources": [
    "references/evidence.md"
  ],
  "profiles": {
    "search": {
      "database": {
        "all": [
          "database.directory"
        ],
        "any": [
          "database.logs.query",
          "database.logs.content_analyze"
        ]
      }
    }
  }
}
