{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbridge.local/schemas/agent-host/v1/transport-recovery.schema.json",
  "title": "AgentBridge Safe Transport Recovery Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "callClass", "automaticRetry", "maximumAttempts", "maximumElapsedMs", "allowedErrorCodes", "sideEffectBoundary"],
  "properties": {
    "schema": {"const": "agentbridge.transport-recovery.v1"},
    "callClass": {"enum": ["read", "prepare", "commit", "resume"]},
    "automaticRetry": {"type": "boolean"},
    "maximumAttempts": {"type": "integer", "minimum": 1, "maximum": 5},
    "maximumElapsedMs": {"type": "integer", "minimum": 1, "maximum": 30000},
    "allowedErrorCodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "sideEffectBoundary": {"enum": ["B0_NO_EFFECT", "B1_PREPARED", "B2_EFFECT_REQUESTED", "B3_EFFECT_CONFIRMED"]}
  }
}
