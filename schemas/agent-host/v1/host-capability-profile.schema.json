{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbridge.local/schemas/agent-host/v1/host-capability-profile.schema.json",
  "title": "AgentBridge Host Capability Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hostInstanceId", "implementation", "levels", "capabilities", "endpointTypes"],
  "properties": {
    "schema": {"const": "agentbridge.host.v1"},
    "hostInstanceId": {"type": "string", "minLength": 1, "maxLength": 160},
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "version": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["L1", "L2", "L3"]},
      "contains": {"const": "L1"}
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mcpApps", "privateResultMeta", "interactionPollResume", "taskTimeline",
        "proactiveDelivery", "artifactDelivery", "restartRecovery", "coordinatorLease",
        "batchTaskTimeline", "runtimeSignals", "boundedTransportRecovery"
      ],
      "properties": {
        "mcpApps": {"type": "boolean"},
        "privateResultMeta": {"type": "boolean"},
        "interactionPollResume": {"type": "boolean"},
        "taskTimeline": {"type": "boolean"},
        "proactiveDelivery": {"type": "boolean"},
        "artifactDelivery": {"type": "boolean"},
        "restartRecovery": {"type": "boolean"},
        "coordinatorLease": {"type": "boolean"},
        "batchTaskTimeline": {"type": "boolean"},
        "runtimeSignals": {"type": "boolean"},
        "boundedTransportRecovery": {"type": "boolean"}
      }
    },
    "endpointTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    }
  }
}
