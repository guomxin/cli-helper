{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbridge.local/schemas/agent-host/v1/host-runtime-snapshot.schema.json",
  "title": "AgentBridge Host Runtime Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "observedAt"],
  "properties": {
    "schema": {"const": "agentbridge.host-runtime-snapshot.v1"},
    "status": {"enum": ["healthy", "degraded", "failed", "stopping"]},
    "observedAt": {"type": "string", "format": "date-time"},
    "uptimeSeconds": {"type": "number", "minimum": 0},
    "activeTaskCount": {"type": "integer", "minimum": 0},
    "waitingInteractionCount": {"type": "integer", "minimum": 0},
    "transportErrorCount": {"type": "integer", "minimum": 0},
    "lastErrorCode": {"type": "string", "maxLength": 120}
  }
}
